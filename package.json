{
  "name": "permit-atlas",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --import tsx scripts/worker.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "reclassify": "node --import tsx scripts/reclassify.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node --import tsx tests/smoke.ts"
  },
  "dependencies": {
    "@next/env": "^16.0.0",
    "csv-parse": "^7.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/leaflet.markercluster": "^1.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
