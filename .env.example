# Uvicorn reads this only when python-dotenv is installed; otherwise export these.
DATABASE_PATH=data/permits.db
INITIAL_LOOKBACK_DAYS=30
SOCRATA_APP_TOKEN=
# Local-only by default. Set both before exposing through a TLS reverse proxy.
APP_USERNAME=
APP_PASSWORD=
# Set to 0 to disable automatic polling (manual Sync still works).
AUTO_SYNC=1
