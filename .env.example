# Next.js and the TypeScript worker load .env.local, then .env. Shell values win.
# Create a fresh PostgreSQL database and run npm run db:migrate. No SQLite import.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/permit_atlas
INITIAL_LOOKBACK_DAYS=30
SOCRATA_APP_TOKEN=
# npm run dev/start bind to loopback. Production requires both credentials.
# Set ALLOWED_HOSTS to the public hostname when deploying behind TLS.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_USERNAME=
APP_PASSWORD=
# Set to 0 to disable automatic polling (manual Sync still works).
AUTO_SYNC=1

# Free Census geocoding of eligible recent leads. No API key.
GEOCODING_ENABLED=1
# DISABLE_WORKER=1 disables all background work (use only for tests/maintenance).

# Optional licensed enrichment. ALL checks below must be configured before requests run.
# Keep disabled until the provider confirms app display/cache/downstream-use rights,
# a no-charge trial entitlement, and the worst-case units for the enabled endpoint(s).
# Free units must be reserved exclusively for this app; shared dashboard usage counts too.
# Never put real keys in this file. Export secrets in the server environment.
REALIE_API_KEY=
REALIE_RIGHTS_CONFIRMED=0
REALIE_NO_CHARGE_CONFIRMED=0
REALIE_TRIAL_ID=
REALIE_TRIAL_EXPIRES=
REALIE_FREE_UNITS=0
REALIE_MAX_UNITS_PER_REQUEST=0
REALIE_CACHE_DAYS=0

MELISSA_API_KEY=
MELISSA_RIGHTS_CONFIRMED=0
MELISSA_NO_CHARGE_CONFIRMED=0
MELISSA_TRIAL_ID=
MELISSA_TRIAL_EXPIRES=
MELISSA_FREE_UNITS=0
MELISSA_MAX_UNITS_PER_REQUEST=0
MELISSA_CACHE_DAYS=0
# Consumer Append is an add-on; a regular credit license does NOT include it.
MELISSA_CONSUMER_APPEND_CONFIRMED=0
